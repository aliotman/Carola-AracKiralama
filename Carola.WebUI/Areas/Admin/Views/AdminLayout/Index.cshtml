@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Carola Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --sidebar-w: 270px;
            --sidebar-collapsed-w: 70px;
            --navbar-h: 68px;
            --bg: #0a0c10;
            --bg2: #111318;
            --bg3: #181c24;
            --bg4: #1e2330;
            --accent: #6c63ff;
            --accent-light: rgba(108,99,255,.15);
            --accent2: #00d4aa;
            --accent2-light: rgba(0,212,170,.12);
            --danger: #ff4d6d;
            --danger-light: rgba(255,77,109,.12);
            --warning: #ffa94d;
            --warning-light: rgba(255,169,77,.12);
            --success: #40c057;
            --success-light: rgba(64,192,87,.12);
            --border: rgba(255,255,255,.06);
            --border2: rgba(255,255,255,.1);
            --text: #e8eaf0;
            --text2: #9097a8;
            --text3: #5a6070;
            --radius: 14px;
            --radius-sm: 8px;
            --radius-lg: 20px;
            --shadow: 0 8px 32px rgba(0,0,0,.5);
            --shadow-sm: 0 2px 12px rgba(0,0,0,.3);
            --transition: .2s cubic-bezier(.4,0,.2,1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--bg4);
            border-radius: 99px;
        }

        /* ── LAYOUT ── */
        #shell {
            display: flex;
            min-height: 100vh;
        }

        /* ── SIDEBAR ── */
        #sidebar {
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--bg2);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: width var(--transition);
            overflow: hidden;
        }

            #sidebar.collapsed {
                width: var(--sidebar-collapsed-w);
            }

                #sidebar.collapsed .nav-text,
                #sidebar.collapsed .brand-text,
                #sidebar.collapsed .section-label,
                #sidebar.collapsed .arrow {
                    display: none !important;
                }

                #sidebar.collapsed .nav-link {
                    justify-content: center;
                    padding: 12px 0;
                }

                #sidebar.collapsed .brand-wrap {
                    justify-content: center;
                    padding: 0 16px;
                }

                #sidebar.collapsed .submenu {
                    display: none !important;
                }

        /* Brand */
        .brand-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 22px;
            height: var(--navbar-h);
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .brand-logo {
            width: 40px;
            height: 40px;
            background: var(--accent);
            border-radius: 12px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            box-shadow: 0 0 20px rgba(108,99,255,.4);
        }

            .brand-logo i {
                color: #fff;
                font-size: 20px;
            }

        .brand-text {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

            .brand-text span {
                color: var(--accent);
            }

        /* Nav */
        .sidebar-nav {
            flex: 1;
            min-height: 0;
            padding: 16px 0;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }

            .sidebar-nav::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar-nav::-webkit-scrollbar-track {
                background: transparent;
            }

            .sidebar-nav::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 3px;
            }

                .sidebar-nav::-webkit-scrollbar-thumb:hover {
                    background: var(--text3);
                }

        .section-label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text3);
            padding: 18px 22px 8px;
        }

        .nav-item-wrap {
            padding: 2px 12px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 14px;
            border-radius: var(--radius-sm);
            color: var(--text2);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all var(--transition);
            white-space: nowrap;
            cursor: pointer;
            border: none;
            background: none;
            width: 100%;
        }

            .nav-link i {
                font-size: 18px;
                flex-shrink: 0;
            }

            .nav-link:hover {
                background: var(--bg3);
                color: var(--text);
            }

            .nav-link.active {
                background: var(--accent-light);
                color: var(--accent);
                font-weight: 600;
            }

                .nav-link.active i {
                    color: var(--accent);
                }

        .arrow {
            margin-left: auto;
            font-size: 12px;
            transition: transform var(--transition);
        }

        .has-submenu.open .arrow {
            transform: rotate(90deg);
        }

        .submenu {
            list-style: none;
            padding: 4px 0 4px 46px;
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease;
        }

        .has-submenu.open .submenu {
            max-height: 300px;
        }

        .submenu li {
            padding: 1px 0;
        }

        .submenu a {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: var(--radius-sm);
            color: var(--text2);
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all var(--transition);
        }

            .submenu a::before {
                content: '';
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: var(--text3);
                flex-shrink: 0;
                transition: background var(--transition);
            }

            .submenu a:hover {
                color: var(--text);
                background: var(--bg3);
            }

                .submenu a:hover::before {
                    background: var(--accent);
                }

            .submenu a.active {
                color: var(--accent);
                font-weight: 600;
            }

                .submenu a.active::before {
                    background: var(--accent);
                }

        /* Sidebar footer */
        .sidebar-foot {
            padding: 12px;
            border-top: 1px solid var(--border);
        }

            .sidebar-foot a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 14px;
                border-radius: var(--radius-sm);
                color: var(--danger);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: background var(--transition);
            }

                .sidebar-foot a:hover {
                    background: var(--danger-light);
                }

        /* ── MAIN ── */
        #main {
            margin-left: var(--sidebar-w);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            transition: margin-left var(--transition);
        }

            #main.expanded {
                margin-left: var(--sidebar-collapsed-w);
            }

        /* ── NAVBAR ── */
        #navbar {
            height: var(--navbar-h);
            background: var(--bg2);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            padding: 0 28px;
            gap: 14px;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .toggle-btn {
            width: 40px;
            height: 40px;
            border: 1px solid var(--border2);
            background: var(--bg3);
            border-radius: var(--radius-sm);
            color: var(--text2);
            display: grid;
            place-items: center;
            cursor: pointer;
            font-size: 18px;
            transition: all var(--transition);
            flex-shrink: 0;
        }

            .toggle-btn:hover {
                background: var(--accent-light);
                color: var(--accent);
                border-color: var(--accent);
            }

        .breadcrumb-nav {
            font-size: 13px;
            color: var(--text2);
        }

            .breadcrumb-nav span {
                color: var(--text);
                font-weight: 600;
            }

        .nav-search {
            flex: 1;
            max-width: 300px;
            position: relative;
            margin-left: 8px;
        }

            .nav-search i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text3);
                font-size: 15px;
            }

            .nav-search input {
                width: 100%;
                background: var(--bg3);
                border: 1px solid var(--border);
                border-radius: var(--radius-sm);
                color: var(--text);
                padding: 9px 14px 9px 38px;
                font-size: 13px;
                font-family: inherit;
                outline: none;
                transition: border var(--transition);
            }

                .nav-search input::placeholder {
                    color: var(--text3);
                }

                .nav-search input:focus {
                    border-color: var(--accent);
                }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-left: auto;
        }

        .icon-btn {
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            background: var(--bg3);
            border-radius: var(--radius-sm);
            color: var(--text2);
            display: grid;
            place-items: center;
            cursor: pointer;
            font-size: 17px;
            position: relative;
            transition: all var(--transition);
        }

            .icon-btn:hover {
                background: var(--bg4);
                color: var(--text);
            }

            .icon-btn .dot {
                position: absolute;
                top: 8px;
                right: 8px;
                width: 7px;
                height: 7px;
                background: var(--danger);
                border-radius: 50%;
                border: 2px solid var(--bg2);
            }

        .profile-pill {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 6px 14px 6px 6px;
            cursor: pointer;
            transition: border var(--transition);
        }

            .profile-pill:hover {
                border-color: var(--border2);
            }

        .profile-avatar {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            display: grid;
            place-items: center;
            font-size: 12px;
            font-weight: 800;
            color: #fff;
            flex-shrink: 0;
        }

        .profile-info .name {
            font-size: 13px;
            font-weight: 600;
            line-height: 1.2;
        }

        .profile-info .role {
            font-size: 11px;
            color: var(--text2);
        }

        /* Dropdown */
        .dropdown-menu {
            background: var(--bg2) !important;
            border: 1px solid var(--border2) !important;
            border-radius: var(--radius) !important;
            box-shadow: var(--shadow) !important;
            padding: 8px !important;
        }

        .dropdown-item {
            color: var(--text2) !important;
            font-size: 13px !important;
            border-radius: var(--radius-sm) !important;
            padding: 10px 14px !important;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all var(--transition) !important;
            font-family: inherit !important;
        }

            .dropdown-item:hover {
                background: var(--bg3) !important;
                color: var(--text) !important;
            }

            .dropdown-item.danger {
                color: var(--danger) !important;
            }

                .dropdown-item.danger:hover {
                    background: var(--danger-light) !important;
                }

        .dropdown-divider {
            border-color: var(--border) !important;
        }

        .dropdown-header {
            color: var(--text3) !important;
            font-size: 11px !important;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Notif */
        .notif-row {
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            transition: background var(--transition);
        }

            .notif-row:hover {
                background: var(--bg3);
            }

        .notif-title {
            font-size: 13px;
            font-weight: 500;
        }

        .notif-time {
            font-size: 11px;
            color: var(--text2);
            margin-top: 2px;
        }

        /* ── CONTENT ── */
        #content {
            flex: 1;
            padding: 32px;
            background: var(--bg);
        }

        /* Page header */
        .page-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .page-title {
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .page-sub {
            font-size: 13px;
            color: var(--text2);
            margin-top: 4px;
        }

        /* KPI Cards */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .kpi-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: all var(--transition);
        }

            .kpi-card:hover {
                border-color: var(--border2);
                transform: translateY(-2px);
                box-shadow: var(--shadow-sm);
            }

        .kpi-icon {
            width: 50px;
            height: 50px;
            border-radius: var(--radius-sm);
            display: grid;
            place-items: center;
            font-size: 22px;
            flex-shrink: 0;
        }

            .kpi-icon.purple {
                background: var(--accent-light);
                color: var(--accent);
            }

            .kpi-icon.teal {
                background: var(--accent2-light);
                color: var(--accent2);
            }

            .kpi-icon.green {
                background: var(--success-light);
                color: var(--success);
            }

            .kpi-icon.red {
                background: var(--danger-light);
                color: var(--danger);
            }

            .kpi-icon.orange {
                background: var(--warning-light);
                color: var(--warning);
            }

        .kpi-val {
            font-size: 26px;
            font-weight: 800;
            line-height: 1;
        }

        .kpi-lbl {
            font-size: 12px;
            color: var(--text2);
            margin-top: 4px;
        }

        /* Buttons */
        .btn-primary-custom {
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: var(--radius-sm);
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: all var(--transition);
            box-shadow: 0 4px 16px rgba(108,99,255,.3);
        }

            .btn-primary-custom:hover {
                opacity: .9;
                transform: translateY(-1px);
                color: #fff;
            }

        .btn-ghost {
            background: var(--bg3);
            color: var(--text2);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: all var(--transition);
        }

            .btn-ghost:hover {
                background: var(--bg4);
                color: var(--text);
                border-color: var(--border2);
            }

        /* Toolbar */
        .toolbar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .toolbar-search {
            position: relative;
            flex: 1;
            min-width: 200px;
            max-width: 360px;
        }

            .toolbar-search i {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text3);
                font-size: 15px;
            }

            .toolbar-search input {
                width: 100%;
                background: var(--bg2);
                border: 1px solid var(--border);
                border-radius: var(--radius-sm);
                color: var(--text);
                padding: 10px 14px 10px 40px;
                font-size: 13px;
                font-family: inherit;
                outline: none;
                transition: border var(--transition);
            }

                .toolbar-search input::placeholder {
                    color: var(--text3);
                }

                .toolbar-search input:focus {
                    border-color: var(--accent);
                }

        .filter-tab {
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text2);
            border-radius: var(--radius-sm);
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            transition: all var(--transition);
        }

            .filter-tab:hover {
                background: var(--bg2);
                color: var(--text);
            }

            .filter-tab.active {
                background: var(--accent-light);
                border-color: var(--accent);
                color: var(--accent);
            }

        /* Table */
        .table-wrap {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            color: var(--text);
        }

            .custom-table thead tr {
                background: var(--bg3);
                border-bottom: 1px solid var(--border);
            }

            .custom-table th {
                padding: 14px 20px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--text2);
                white-space: nowrap;
            }

            .custom-table tbody tr {
                border-bottom: 1px solid var(--border);
                transition: background var(--transition);
            }

                .custom-table tbody tr:last-child {
                    border-bottom: none;
                }

                .custom-table tbody tr:hover {
                    background: var(--bg3);
                }

            .custom-table td {
                padding: 14px 20px;
                font-size: 13px;
                vertical-align: middle;
            }

        /* Avatar */
        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-size: 13px;
            font-weight: 700;
            flex-shrink: 0;
        }

            .avatar.purple {
                background: var(--accent-light);
                color: var(--accent);
            }

            .avatar.teal {
                background: var(--accent2-light);
                color: var(--accent2);
            }

        /* Badge */
        .badge-custom {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
        }

            .badge-custom.success {
                background: var(--success-light);
                color: var(--success);
            }

            .badge-custom.danger {
                background: var(--danger-light);
                color: var(--danger);
            }

            .badge-custom.warning {
                background: var(--warning-light);
                color: var(--warning);
            }

            .badge-custom.purple {
                background: var(--accent-light);
                color: var(--accent);
            }

        /* Action buttons */
        .act-btn {
            width: 34px;
            height: 34px;
            border-radius: var(--radius-sm);
            display: grid;
            place-items: center;
            text-decoration: none;
            font-size: 15px;
            transition: all var(--transition);
            border: none;
            cursor: pointer;
        }

            .act-btn.edit {
                background: var(--accent-light);
                color: var(--accent);
            }

            .act-btn.delete {
                background: var(--danger-light);
                color: var(--danger);
            }

            .act-btn.view {
                background: var(--accent2-light);
                color: var(--accent2);
            }

            .act-btn:hover {
                opacity: .75;
                transform: scale(.95);
            }

        /* Card grid (araçlar için) */
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .car-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            transition: all var(--transition);
        }

            .car-card:hover {
                border-color: var(--border2);
                transform: translateY(-3px);
                box-shadow: var(--shadow-sm);
            }

        .car-card-img {
            position: relative;
            height: 175px;
            background: var(--bg3);
            overflow: hidden;
        }

            .car-card-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform .5s ease;
            }

        .car-card:hover .car-card-img img {
            transform: scale(1.05);
        }

        .car-card-body {
            padding: 16px 18px;
        }

        .car-card-foot {
            padding: 12px 18px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 8px;
        }

        .car-card-btn {
            flex: 1;
            border: none;
            border-radius: var(--radius-sm);
            padding: 9px;
            font-size: 12px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            transition: opacity var(--transition);
            text-decoration: none;
        }

            .car-card-btn:hover {
                opacity: .8;
            }

            .car-card-btn.edit {
                background: var(--accent-light);
                color: var(--accent);
            }

            .car-card-btn.delete {
                background: var(--danger-light);
                color: var(--danger);
                flex: 0 0 36px;
            }

        /* Form */
        .form-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px;
        }

        .form-section-title {
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .form-section-title i {
                color: var(--accent);
            }

        .form-label-custom {
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .8px;
            color: var(--text2);
            margin-bottom: 6px;
            display: block;
        }

        .form-input {
            width: 100%;
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            color: var(--text);
            padding: 11px 14px;
            font-size: 14px;
            font-family: inherit;
            outline: none;
            transition: border var(--transition), box-shadow var(--transition);
        }

            .form-input::placeholder {
                color: var(--text3);
            }

            .form-input:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(108,99,255,.15);
            }

        /* Toast */
        .toast-wrap {
            z-index: 9999;
        }

        .custom-toast {
            background: var(--bg2) !important;
            border: 1px solid var(--border2) !important;
            border-radius: var(--radius) !important;
            color: var(--text) !important;
            box-shadow: var(--shadow) !important;
        }

        /* Modal */
        .modal-content {
            background: var(--bg2) !important;
            border: 1px solid var(--border2) !important;
            border-radius: var(--radius) !important;
            color: var(--text) !important;
        }

        .modal-header {
            border-bottom: 1px solid var(--border) !important;
        }

        .modal-footer {
            border-top: 1px solid var(--border) !important;
        }

        .btn-close {
            filter: invert(1) opacity(.4);
        }

        /* Overlay */
        #overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.6);
            z-index: 999;
            backdrop-filter: blur(3px);
        }

            #overlay.show {
                display: block;
            }

        @@media (max-width: 768px) {
            #sidebar

        {
            transform: translateX(-100%);
        }

        #sidebar.mobile-open {
            transform: translateX(0);
            width: var(--sidebar-w);
        }

        #main {
            margin-left: 0 !important;
        }

        #content {
            padding: 20px 16px;
        }

        }
    </style>
</head>
<body>

    <div id="overlay" onclick="closeMobile()"></div>

    <div id="shell">

        <!-- SIDEBAR -->
        <aside id="sidebar">
            <div class="brand-wrap">
                <div class="brand-logo"><i class="bi bi-car-front-fill"></i></div>
                <div class="brand-text"><span>Carola</span> Admin</div>
            </div>

            <nav class="sidebar-nav">
                <ul class="list-unstyled">

                    <li class="nav-item-wrap">
                        <a href="/Admin/AdminLayout/Index" class="nav-link">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span class="nav-text">Kontrol Paneli</span>
                        </a>
                    </li>

                    <div class="section-label">Araç Yönetimi</div>

                    <li class="nav-item-wrap has-submenu" id="menu-cars">
                        <button class="nav-link" onclick="toggleMenu('menu-cars')">
                            <i class="bi bi-car-front"></i>
                            <span class="nav-text">Araçlar</span>
                            <i class="bi bi-chevron-right arrow"></i>
                        </button>
                        <ul class="submenu list-unstyled">
                            <li><a href="/Admin/Car/CarList">Araç Listesi</a></li>
                            <li><a href="/Admin/Car/CreateCar">Araç Ekle</a></li>
                        </ul>
                    </li>

                    <li class="nav-item-wrap has-submenu" id="menu-brands">
                        <button class="nav-link" onclick="toggleMenu('menu-brands')">
                            <i class="bi bi-bookmark-star"></i>
                            <span class="nav-text">Markalar</span>
                            <i class="bi bi-chevron-right arrow"></i>
                        </button>
                        <ul class="submenu list-unstyled">
                            <li><a href="/Admin/Brand/BrandList">Marka Listesi</a></li>
                            <li><a href="/Admin/Brand/CreateBrand">Marka Ekle</a></li>
                        </ul>
                    </li>

                    <li class="nav-item-wrap has-submenu" id="menu-slider">
                        <button class="nav-link" onclick="toggleMenu('menu-slider')">
                            <i class="bi bi-images"></i>
                            <span class="nav-text">Slider</span>
                            <i class="bi bi-chevron-right arrow"></i>
                        </button>
                        <ul class="submenu list-unstyled">
                            <li><a href="/Admin/Slider/SliderList">Slider Listesi</a></li>
                            <li><a href="/Admin/Slider/CreateSlider">Slider Ekle</a></li>
                        </ul>
                    </li>

                    <div class="section-label">Rezervasyonlar</div>

                    <li class="nav-item-wrap has-submenu" id="menu-reservations">
                        <button class="nav-link" onclick="toggleMenu('menu-reservations')">
                            <i class="bi bi-calendar-check"></i>
                            <span class="nav-text">Rezervasyonlar</span>
                            <i class="bi bi-chevron-right arrow"></i>
                        </button>
                        <ul class="submenu list-unstyled">
                            <li><a href="/Admin/Reservation/ReservationList">Tüm Rezervasyonlar</a></li>
                            <li><a href="/Admin/Reservation/PendingList">Onay Bekleyenler</a></li>
                        </ul>
                    </li>

                    <div class="section-label">CRM</div>

                    <li class="nav-item-wrap">
                        <a href="/Admin/Customer/CustomerList" class="nav-link">
                            <i class="bi bi-people"></i>
                            <span class="nav-text">Müşteriler</span>
                        </a>
                    </li>

                    <li class="nav-item-wrap has-submenu" id="menu-locations">
                        <button class="nav-link" onclick="toggleMenu('menu-locations')">
                            <i class="bi bi-shop"></i>
                            <span class="nav-text">Şubeler</span>
                            <i class="bi bi-chevron-right arrow"></i>
                        </button>
                        <ul class="submenu list-unstyled">
                            <li><a href="/Admin/Location/LocationList">Şube Listesi</a></li>
                            <li><a href="/Admin/Location/CreateLocation">Şube Ekle</a></li>
                        </ul>
                    </li>

                </ul>
            </nav>

            <div class="sidebar-foot">
                <a href="/">
                    <i class="bi bi-box-arrow-left"></i>
                    <span class="nav-text">Siteye Dön</span>
                </a>
            </div>
        </aside>

        <!-- MAIN -->
        <div id="main">

            <!-- NAVBAR -->
            <header id="navbar">
                <button class="toggle-btn" onclick="toggleSidebar()">
                    <i class="bi bi-layout-sidebar"></i>
                </button>

                <div class="breadcrumb-nav d-none d-md-block">
                    Admin &rsaquo; <span>@ViewData["Title"]</span>
                </div>

                <div class="nav-search d-none d-lg-flex">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Ara..." />
                </div>

                <div class="nav-right">
                    <div class="dropdown">
                        <button class="icon-btn" data-bs-toggle="dropdown">
                            <i class="bi bi-bell"></i>
                            <span class="dot"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" style="min-width:280px;">
                            <li><h6 class="dropdown-header">Bildirimler</h6></li>
                            <li>
                                <div class="notif-row">
                                    <div class="notif-title">Yeni rezervasyon talebi</div>
                                    <div class="notif-time">2 dakika önce</div>
                                </div>
                            </li>
                            <li>
                                <div class="notif-row">
                                    <div class="notif-title">Araç iadesi yapıldı</div>
                                    <div class="notif-time">1 saat önce</div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item justify-content-center" href="#">Tümünü Gör</a></li>
                        </ul>
                    </div>

                    <div class="dropdown">
                        <div class="profile-pill" data-bs-toggle="dropdown">
                            <div class="profile-avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")</div>
                            <div class="profile-info d-none d-sm-block">
                                <div class="name">@(User.Identity?.Name ?? "Admin")</div>
                                <div class="role">Yönetici</div>
                            </div>
                            <i class="bi bi-chevron-down ms-1" style="font-size:11px;color:var(--text2);"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">Hesap</h6></li>
                            <li><a class="dropdown-item" href="/"><i class="bi bi-globe"></i> Siteyi Görüntüle</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item danger" href="/Admin/Login/Logout"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- CONTENT -->
            <div id="content">
                @RenderBody()
            </div>

        </div>
    </div>

    <!-- Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3 toast-wrap">
        <div id="toast" class="toast custom-toast align-items-center" role="alert">
            <div class="d-flex">
                <div class="toast-body" id="toastMsg">İşlem başarılı.</div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const main = document.getElementById('main');
            if (window.innerWidth <= 768) {
                sidebar.classList.toggle('mobile-open');
                document.getElementById('overlay').classList.toggle('show');
            } else {
                sidebar.classList.toggle('collapsed');
                main.classList.toggle('expanded');
            }
        }

        function closeMobile() {
            document.getElementById('sidebar').classList.remove('mobile-open');
            document.getElementById('overlay').classList.remove('show');
        }

        function toggleMenu(id) {
            document.getElementById(id).classList.toggle('open');
        }

        function showToast(msg) {
            document.getElementById('toastMsg').textContent = msg;
            new bootstrap.Toast(document.getElementById('toast'), { delay: 3000 }).show();
        }
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>