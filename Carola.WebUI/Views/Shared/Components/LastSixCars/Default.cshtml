@model List<Carola.DtoLayer.Dtos.CarDtos.CarListDto>

<!-- Öne Çıkan Araçlar Bölümü -->
<section class="featured-car-section pt_120 pb_90" style="background-image: url(/carola/assets/images/background/most-popular-car.jpg);">
    <div class="container">
        <div class="section-title centred mb_60">
            <span class="sub-title">Araçlarımız</span>
            <h2 class="title">Öne Çıkan Araçlar</h2>
        </div>
        <div class="row">
            @foreach (var car in Model)
            {
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12">
                    <div class="single-featured-car-block style_two">
                        <div class="single-featured-car-image">
                            <a href="/Car/List"><img src="@car.ImageUrl" alt="@car.Brand @car.Model"></a>
                        </div>
                        <div class="single-featured-car-content">
                            <h5 class="single-featured-car-title">
                                <a href="/Car/List">@car.Brand @car.Model</a>
                            </h5>
                            <div class="single-featured-car-rent-per-day-2">
                                <span>₺@car.DailyPrice</span>/ Gün
                            </div>
                            <div class="border-divider"></div>
                            <div class="featured-car-info-outer">
                                <ul class="single-featured-car-info">
                                    <li><i class="icon-6"></i>@car.FuelType</li>
                                    <li><i class="icon-30"></i>@car.TransmissionType</li>
                                </ul>
                                <ul class="single-featured-car-info">
                                    <li><i class="icon-8"></i>@car.SeatCount Koltuk</li>
                                    <li><i class="icon-7"></i>@car.ModelYear</li>
                                </ul>
                            </div>
                            <div class="single-featured-car-book-btn">
                                <a href="/Car/List" class="btn-style-three">Kirala</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Öne Çıkan Araçlar Bölümü Sonu -->