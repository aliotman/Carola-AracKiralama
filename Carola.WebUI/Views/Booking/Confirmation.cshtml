@{
    ViewData["Title"] = "Rezervasyon Onayı";
}

@await Html.PartialAsync("_Header")

@await Html.PartialAsync("_Banner", "Rezervasyon Talebi Alındı")

<section class="pt_120 pb_120" style="background-color: #f8f9fa;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8 col-md-10 col-sm-12">
                <div class="card border-0 shadow-sm text-center p-5" style="border-radius: 16px;">

                    <div class="mb_30">
                        <i class="fas fa-clock" style="font-size: 80px; color: #f5a623;"></i>
                    </div>

                    <h2 class="mb_15" style="font-weight: 700; color: #1a1a2e;">
                        Rezervasyonunuz Onay Bekliyor
                    </h2>
                    <p class="text-muted mb_30">
                        Rezervasyon talebiniz başarıyla alınmıştır. Yöneticimiz en kısa sürede
                        talebinizi inceleyecek ve e-posta adresinize bilgilendirme yapılacaktır.
                    </p>

                    <div class="card mb_30" style="border-radius: 10px; background: #f8f9fa; border: 1px solid #dee2e6;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Rezervasyon No</span>
                                <span class="fw-bold">#@ViewBag.ReservationId</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Alış Tarihi</span>
                                <span class="fw-bold">@ViewBag.PickupDate</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">İade Tarihi</span>
                                <span class="fw-bold">@ViewBag.ReturnDate</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Toplam Tutar</span>
                                <span class="fw-bold" style="color: #e63946;">₺@ViewBag.TotalPrice</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Durum</span>
                                <span class="badge" style="background-color: #f5a623; font-size: 14px;">
                                    @ViewBag.Status
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info mb_30" style="border-radius: 10px;">
                        <i class="fas fa-envelope me-2"></i>
                        Onay bilgisi e-posta adresinize gönderilecektir.
                    </div>

                    <a href="/" class="btn-style-one py-3 px-5" style="border-radius: 10px;">
                        <i class="fas fa-home me-2"></i> Ana Sayfaya Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_Footer")

<button class="scroll-top scroll-to-target" data-target="html">
    <i class="icon-13"></i>
</button>

@await Html.PartialAsync("_Scripts")